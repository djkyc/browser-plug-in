{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Multi Mail Notifier"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content-proton.js"
      ],
      "matches": [
        "https://mail.proton.me/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "content-outlook.js"
      ],
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Check unread mail across Gmail, Outlook, Hotmail, Live and Proton accounts in one popup. No password needed.",
  "host_permissions": [
    "https://mail.google.com/*",
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://*.workers.dev/*",
    "https://mmn-gmail-oauth.bit.indevs.in/*",
    "https://mmn-outlook-oauth.bit.indevs.in/*",
    "https://accounts.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://mail.proton.me/*",
    "https://*.live.com/*",
    "https://login.microsoftonline.com/*",
    "https://*.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://dav.jianguoyun.com/*",
    "https://dav.infini-cloud.net/*",
    "https://higa.teracloud.jp/*",
    "https://raw.githubusercontent.com/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Multi Mail Notifier — Gmail / Outlook / Proton 多账号",
  "options_page": "options.html",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "webRequest",
    "identity",
    "identity.email"
  ],
  "oauth2": {
    "client_id": "940110558797-2jrp985nahho6cce4j4sj6lv9pasi0ja.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/gmail.send"
    ]
  },
  "version": "1.15.80"
}